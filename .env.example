# Paisa Pulse Environment Configuration

# Flask Secret Key for session encryption (optional, random default used if omitted)
SECRET_KEY=your-super-secret-key-change-in-production

# Database Connection URL (PostgreSQL)
# For Supabase (Session Pooler - Recommended for IPv4/Render):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres
# For Supabase (Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Render PostgreSQL / Neon:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# If DATABASE_URL is left blank or unreachable, Paisa Pulse automatically uses local SQLite (finance.db).
DATABASE_URL=